{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "esnext.temporal"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["test/**/*.ts", "bench/**/*.ts", "vitest.config.ts", "*.d.ts"]
}
